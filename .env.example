DISCORD_TOKEN=Your discord token here
CLIENT_ID=Your bot id here
GUILD_ID=Your guild id here # (optional, for testing commands in a specific guild)

// OpenAI API configuration
OPENAI_API_KEY=Your OpenAI API key here
OPENAI_MODEL=gpt-4.1
OPENAI_INSTRUCTIONS="You are a discord bot. Answer the user's questions using the conversation history."
TEMPERATURE=0.7
MAX_HISTORY_MESSAGES=5

// Image generation settings
OPENAI_IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024
IMAGE_COUNT=1
IMAGE_QUALITY=low